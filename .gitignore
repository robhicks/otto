# Rust / Cargo
/target
# Crate-local build dirs (e.g. `cargo generate-rpm` run from inside a member writes
# target/generate-rpm/ there)
**/target
**/*.rs.bk
# Stray compiler outputs outside target/ (e.g. ad-hoc `rustc` probes)
*.rlib

# Node / UI (ui/ retired in dioxus Phase 4)

# macOS
.DS_Store

# Heap snapshots
*.heapsnapshot

# Runtime sqlite stores (e.g. otto serve session store)
*.db
*.db-shm
*.db-wal

# Local git worktrees (isolated feature-branch workspaces)
/.worktrees

# Playwright MCP debug artifacts
.playwright-mcp/
